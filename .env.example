# SolarShare Backend — Environment Configuration Example
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit a real `.env` file with production secrets.

# --- App metadata ---
APP_NAME=SolarShare
APP_ENV=development
DEBUG=true

# --- Database ---
# SQLite is the Phase 1 default for local development/demo.
# Swap to a PostgreSQL URL later without code changes, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/solarshare
DATABASE_URL=sqlite:///./solarshare.db

# --- Auth / JWT ---
# Generate a real secret for any non-local environment, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-real-deployments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS (for later frontend integration) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- NASA POWER integration (Phase 2) ---
# Public Hourly Point API — no API key required for this endpoint.
# Do NOT hardcode these values elsewhere; the app reads them from here.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/hourly/point
NASA_POWER_COMMUNITY=RE
NASA_POWER_PARAMETERS=ALLSKY_SFC_SW_DWN,T2M,RH2M,WS10M
NASA_POWER_TIME_STANDARD=UTC
NASA_POWER_FORMAT=JSON
NASA_POWER_REQUEST_TIMEOUT_SECONDS=30.0
NASA_POWER_MAX_RETRIES=3
NASA_POWER_RETRY_BACKOFF_SECONDS=2.0
NASA_POWER_FILL_VALUE=-999.0

# --- Public electricity dataset (Phase 2) ---
# Source: Zenodo "Electricity Hourly Dataset", DOI 10.5281/zenodo.4656140.
# Public proxy tenant-load dataset — NOT real Coimbatore MSME smart-meter data.
ELECTRICITY_DATASET_SOURCE_NAME=Electricity Hourly Dataset (Monash/Zenodo)
ELECTRICITY_DATASET_SOURCE_DOI=10.5281/zenodo.4656140
ELECTRICITY_DATASET_SOURCE_URL=https://zenodo.org/records/4656140
# Local path to the acquired .tsf file (download separately; see README).
ELECTRICITY_DATASET_LOCAL_PATH=
ELECTRICITY_DATASET_REQUEST_TIMEOUT_SECONDS=60.0
